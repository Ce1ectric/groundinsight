# Resolve the dependency tree as it stood two weeks before the pin was made:
# a release younger than that has had no time to be noticed if it is bad.
# bundle_vendor.py passes the same date on `npm install`; `npm ci` installs
# exactly package-lock.json and checks every tarball against its integrity.
before=2026-11-01
save-exact=true
fund=false
audit=true
