    affiliation: Avacon Netz GmbH
version: "0.3.1"
license: MIT
repository-code: "https://github.com/Ce1ectric/groundinsight"
url: "https://ce1ectric.github.io/groundinsight/"
keywords:
  - grounding-system
  - earth-potential-rise
  - reduction-factor
  - power-systems
  - simulation
  - python
